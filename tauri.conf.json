{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Borrow Checker",
  "version": "0.1.0",
  "identifier": "li.borrowchecker.app",
  "build": {
    "beforeDevCommand": "bun run build:watch",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Borrow Checker",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
